<svg viewBox="0 0 1200 380" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Alishba Riasat, Full-Stack Developer" xmlns:c2pa="http://c2pa.org/manifest"><metadata><c2pa:manifest></c2pa:manifest></metadata>
  <title>Alishba Riasat — Full-Stack Developer</title>
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#140B14"/>
      <stop offset="100%" stop-color="#1E1120"/>
    </linearGradient>
    <style>
      @keyframes fadeInSoft { from { opacity: 0; } to { opacity: 0.6; } }
      @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
      @keyframes revealName { from { clip-path: inset(0 100% 0 0); } to { clip-path: inset(0 0% 0 0); } }
      @keyframes drawLine { from { stroke-dashoffset: 100; } to { stroke-dashoffset: 0; } }
      @keyframes blinkCursor { 0%, 45% { opacity: 1; } 50%, 95% { opacity: 0; } 100% { opacity: 1; } }
      @keyframes pulseSpark { 0%, 100% { opacity: 0.55; transform: scale(1); } 50% { opacity: 1; transform: scale(1.12); } }

      .corner { opacity: 0; animation: fadeInSoft 0.9s ease-out 0.1s forwards; }
      .name { clip-path: inset(0 100% 0 0); animation: revealName 1s cubic-bezier(0.22, 1, 0.36, 1) 0.3s forwards; }
      .role { opacity: 0; animation: fadeIn 0.6s ease-out 1.25s forwards; }
      .cursor { animation: blinkCursor 1.1s steps(1) 1.7s infinite; }
      .underline { stroke-dasharray: 100; stroke-dashoffset: 100; animation: drawLine 0.8s ease-out 1.6s forwards; }
      .tagline-1 { opacity: 0; animation: fadeIn 0.8s ease-out 2s forwards; }
      .tagline-2 { opacity: 0; animation: fadeIn 0.8s ease-out 2.25s forwards; }
      .spark { transform-origin: 500px 123px; animation: pulseSpark 3.2s ease-in-out 2.4s infinite; }
    </style>
  </defs>

  <rect x="0" y="0" width="1200" height="380" fill="url(#bg)"/>

  <g class="corner" stroke="#9B2F5E" stroke-width="1.5" stroke-linecap="round">
    <path d="M 32 32 L 32 54 M 32 32 L 54 32" fill="none"/>
    <path d="M 1168 32 L 1168 54 M 1168 32 L 1146 32" fill="none"/>
    <path d="M 32 348 L 32 326 M 32 348 L 54 348" fill="none"/>
    <path d="M 1168 348 L 1168 326 M 1168 348 L 1146 348" fill="none"/>
  </g>

  <path class="spark" d="M 500 96 L 507 116 L 527 123 L 507 130 L 500 150 L 493 130 L 473 123 L 493 116 Z" fill="#C23E75"/>

  <text class="name" x="90" y="178" font-family="Georgia, 'Times New Roman', serif" font-size="66" font-weight="700" letter-spacing="-1" fill="#F5EDE8">Alishba Riasat</text>

  <text class="role" x="92" y="216" font-family="'Courier New', Courier, monospace" font-size="19" font-weight="600" letter-spacing="0.5" fill="#C23E75">&lt;full-stack developer /&gt;<tspan class="cursor">▌</tspan></text>

  <line class="underline" x1="92" y1="238" x2="182" y2="238" stroke="#9B2F5E" stroke-width="2" stroke-linecap="round" pathLength="100"/>

  <text class="tagline-1" x="90" y="284" font-family="Georgia, 'Times New Roman', serif" font-style="italic" font-size="22" fill="#A67C89">Interfaces on one side, systems on the other.</text>
  <text class="tagline-2" x="90" y="314" font-family="Georgia, 'Times New Roman', serif" font-style="italic" font-size="22" fill="#A67C89">I work in between.</text>
</svg>
